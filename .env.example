# Copy to .env next to docker-compose.yml (never commit .env).
WEBUI_URL=https://ai-lxc.your-tailnet.ts.net:8443
WEBUI_SECRET_KEY=generate-with: python3 -c "import secrets;print(secrets.token_hex(32))"
ENABLE_LOGIN_FORM=true

# OAuth apps: set the callback/redirect URL in each provider console to
#   ${WEBUI_URL}/oauth/google/callback   and   ${WEBUI_URL}/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Only for the optional `orchestrator` profile
VPC_OLLAMA_MODEL=gemma4-e2b-qat
VPC_PC2_URL=http://100.x.y.z:8765
VPC_PC2_SECRET=
