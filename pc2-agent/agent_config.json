{
  "_comment": "Example PC2 config. Copy to agent_config.local.json (gitignored) and adjust. Every app must also be in the PC1 knowledge file. With pc1_ws_url set the agent dials OUT to PC1 and opens no port (bind_host/port/allowed_clients are then unused).",
  "pc1_ws_url": "wss://pc.example.com/agent/ws",
  "apps": {
    "chrome": {"process": "chrome.exe", "argv": ["%ProgramFiles%\\Google\\Chrome\\Application\\chrome.exe"]},
    "notepad": {"process": "notepad.exe", "argv": ["notepad.exe"]},
    "spotify": {"process": "Spotify.exe", "uri": "spotify:"},
    "calculator": {"process": "CalculatorApp.exe", "uri": "calculator:"},
    "explorer": {"process": "explorer.exe", "argv": ["explorer.exe"]},
    "cursor": {"process": "Cursor.exe", "argv": ["%LOCALAPPDATA%\\Programs\\cursor\\Cursor.exe"]},
    "vscode": {"process": "Code.exe", "argv": ["%LOCALAPPDATA%\\Programs\\Microsoft VS Code\\Code.exe"]}
  },
  "browser_argv": ["%ProgramFiles%\\Google\\Chrome\\Application\\chrome.exe"],
  "browser_process": "chrome.exe",
  "allowed_hosts": ["youtube.com", "google.com", "github.com", "facebook.com", "wikipedia.org"],
  "allowed_clients": ["127.0.0.1"],
  "rate_limit_per_min": 30,
  "verify_timeout_s": 8,
  "tool_timeout_s": 15,
  "data_dir": "%LOCALAPPDATA%\\voice-pc-agent",
  "bind_host": "127.0.0.1",
  "port": 8765
}
