# PC1 orchestrator image (build context = repo root).
FROM node:20.18-bookworm-slim AS pwa
WORKDIR /pwa
COPY mobile-pwa/package.json mobile-pwa/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY mobile-pwa/ ./
RUN npm run build

FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/contracts:/app/pc1-orchestrator \
    VPC_DB=/data/vpc.sqlite3 VPC_STATIC_DIR=/app/pwa
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt faster-whisper
COPY contracts/ contracts/
COPY pc1-orchestrator/ pc1-orchestrator/
COPY --from=pwa /pwa/dist /app/pwa
RUN useradd --uid 10001 --create-home vpc && mkdir -p /data && chown vpc /data
USER vpc
WORKDIR /app/pc1-orchestrator
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/health')"
CMD ["uvicorn", "app.main:build", "--factory", "--host", "0.0.0.0", "--port", "8000"]
