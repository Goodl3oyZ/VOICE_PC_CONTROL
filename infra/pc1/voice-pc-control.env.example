# /etc/voice-pc-control.env  (chmod 640, owner root:vpc) — settings for the PC1 orchestrator service.
# Full reference: pc1-orchestrator/app/settings.py and docs/DEPLOYMENT.md §4.
# IMPORTANT: keep a trailing newline at the end of this file (appending to a file without one merges lines).

VPC_DB=/var/lib/vpc/vpc.sqlite3
VPC_KNOWLEDGE=/opt/voice-pc-control/pc1-orchestrator/data/knowledge.live.json
VPC_STATIC_DIR=/opt/voice-pc-control/mobile-pwa/dist

# Interface language: en = English-only commands/replies (other languages rejected); th = Thai
VPC_LANGUAGE=en
VPC_STT_CONF_MIN=0.55

# Speech-to-text (CPU — the GPU is reserved for the LLM)
VPC_STT=faster_whisper
VPC_STT_DEVICE=cpu
VPC_WHISPER_MODEL=small
VPC_WHISPER_COMPUTE=int8
VPC_STT_TIMEOUT_S=30

# LLM via Ollama (docker-compose.yml at repo root). Do not set num_ctx per client (forces model reloads).
VPC_LLM=ollama
VPC_OLLAMA_URL=http://127.0.0.1:11434
VPC_OLLAMA_MODEL=gemma4-e2b-qat
VPC_LLM_TIMEOUT_S=30

# PC2 link: "relay" = the Windows agent dials OUT to wss://<public host>/agent/ws (no VPN, no open port)
VPC_PC2=relay
VPC_PC2_SECRET=CHANGE_ME_64_hex_chars_same_value_as_PC2_credential_manager
VPC_HEARTBEAT_S=5

# Public web access (Cloudflare tunnel) — Google login + one-time Secret Key per device
VPC_PUBLIC_URL=https://pc.example.com
VPC_SESSION_SECRET=CHANGE_ME_python3_-c_import_secrets_print_secrets_token_hex_32
VPC_GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
VPC_GOOGLE_CLIENT_SECRET=CHANGE_ME
VPC_ALLOWED_EMAILS=you@gmail.com
VPC_ALLOW_BEARER=false
